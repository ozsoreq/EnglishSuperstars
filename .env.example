# Neural voices (Azure AI Speech). Without these the app uses device voices.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# Optional voice overrides
# AZURE_TTS_VOICE_EN=en-US-JennyNeural
# AZURE_TTS_VOICE_HE=he-IL-HilaNeural
# AZURE_TTS_VOICE_CHILD=en-US-AnaNeural

# Recording only (npm run voice): Google Cloud TTS key for the Hebrew voice pack.
# Not needed at runtime — recordings ship as static files.
# GOOGLE_TTS_API_KEY=
# GOOGLE_TTS_VOICE_HE=
